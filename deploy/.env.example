# AttackLedger production settings. Copy to .env in the install folder (next to
# docker-compose.yml) and fill in; docs/INSTALL.md step 4 does it with one command that
# generates every secret. Keep .env readable by root only (chmod 600). Never commit it.

# ---- Docker Compose ---------------------------------------------------------
# Every `docker compose` command in this folder uses both files and this project name.
COMPOSE_FILE=docker-compose.yml:deploy/compose.prod.yml
COMPOSE_PROJECT_NAME=attackledger

# ---- Secrets (generated at install time) ------------------------------------
# Postgres password. Hex only, because it is also part of a database URL. Empty here on
# purpose: Compose refuses to start until it is set.
POSTGRES_PASSWORD=

# Operator token: an owner-level key for scripts (Authorization: Bearer ...). Leave empty
# unless you automate against the API. While set it works as an owner; it cannot sign receipts.
ATTACKLEDGER_API_TOKEN=

# ---- HTTPS (deploy/Caddyfile) -----------------------------------------------
# The name people type in the browser. Its DNS record must point at this server.
ATTACKLEDGER_HOSTNAME=attackledger.example.com
# Where the certificate comes from: an email address (Let's Encrypt), the two paths
# "/certs/fullchain.pem /certs/key.pem" (your own certificate in deploy/certs/), or
# "internal" (Caddy's own CA, for tests only).
ATTACKLEDGER_TLS=you@example.com
# Host ports. Change only if 80 and 443 are taken (Let's Encrypt needs 80).
ATTACKLEDGER_HTTP_PORT=80
ATTACKLEDGER_HTTPS_PORT=443

# ---- Timestamps (D-034) -----------------------------------------------------
# RFC 3161 timestamp authority for receipts. Only a SHA-256 hash is sent, once per closed
# lane. "off" sends nothing and receipts carry no timestamp.
ATTACKLEDGER_TSA_URL=http://timestamp.digicert.com

# ---- Encryption at rest (D-043) ---------------------------------------------
# Where the master key file is on this server. The key itself never goes in this file.
# It is mounted read-only into the API and the worker (docs/INSTALL.md, section 7).
ATTACKLEDGER_MASTER_KEY_PATH=/etc/attackledger/master.key

# ---- Traffic gateway (D-039) ------------------------------------------------
# Every request from the worker leaves through the gateway (docs/INSTALL.md, section 6).
# It needs no settings. Extra passive-source hosts (comma-separated), for subfinder sources
# you configured with your own keys:
ATTACKLEDGER_GATEWAY_PASSIVE_HOSTS=

# ---- Claude agents (optional) -----------------------------------------------
# Leave empty to run without agents. The key stays in the worker.
ANTHROPIC_API_KEY=
ATTACKLEDGER_AGENT_MODEL=

# ---- Resource limits (optional; defaults in deploy/compose.prod.yml) ---------
# ATTACKLEDGER_WORKER_MEMORY=4g
# ATTACKLEDGER_WORKER_CPUS=2
# ATTACKLEDGER_DB_MEMORY=2g
# ATTACKLEDGER_API_MEMORY=1g
