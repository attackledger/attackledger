{
  "target": "OWASP Juice Shop v20.2.0 (bkimminich/juice-shop@sha256:8739101ade29358abb5469ee66ae78e582c97ed0a5543a4ad102e5fa5193526b), as juice.lab.test:3000",
  "written": "2026-10-09, before the first recon or agent run (matchers are not tuned to results)",
  "criteria": "An item is in reach when it can be observed (and, for a challenge, triggered) with unauthenticated GET, HEAD or OPTIONS requests to juice.lab.test only: no login, no state-changing method, no browser that runs JavaScript, no brute force or guessing beyond the content-discovery wordlist, and no computation outside HTTP beyond simple decoding (base64, ROT13). Recon 'surfaced' an item when an endpoint or lead it recorded points straight at it (a reviewer opening that URL or reading that lead sees the issue). The agent 'found' an item when an evidence entry or lead from its run shows the issue.",
  "reasons": {
    "docker": "disabled by Juice Shop itself when it runs in Docker (disabledEnv: Docker)",
    "post": "needs a state-changing request (POST, PUT, PATCH or DELETE); agents send read-only requests only (D-024) and recon never writes",
    "login": "needs a signed-in session; signing in is a POST with a password, and agents never enter passwords",
    "submit": "the information can be observed with GET, but solving means submitting it through POST /api/Feedbacks or /api/Complaints",
    "browser": "needs a browser that renders the single-page app or runs JavaScript (DOM XSS, UI interaction, text only visible after rendering)",
    "brute": "needs brute force or guessing beyond the content-discovery wordlist, which the rules forbid",
    "compute": "needs computation outside HTTP (signing a token, decryption, deobfuscating or running JavaScript, binary analysis); the agent has no code execution",
    "llm": "needs the chatbot's LLM backend (not reachable in the isolated lab) and POST requests",
    "web3": "needs a wallet and a blockchain network (POST requests, unreachable in the isolated lab)",
    "external": "needs a third-party site or another origin"
  },
  "challenges": {
    "web3SandboxChallenge": {"in_reach": true, "observe": "hidden SPA route web3-sandbox named in main.js", "recon": [["any", "web3-sandbox"]]},
    "missingEncodingChallenge": {"in_reach": true, "observe": "GET /rest/memories lists the cat photo; requesting it with '#' encoded as %23", "recon": [["any", "zatschi|whoneedsfourlegs"]]},
    "privacyPolicyChallenge": {"in_reach": true, "observe": "SPA route privacy-security/privacy-policy named in main.js", "recon": [["any", "privacy-policy"]]},
    "scoreBoardChallenge": {"in_reach": true, "observe": "hidden SPA route score-board named in main.js", "recon": [["any", "score-board"]]},
    "exposedMetricsChallenge": {"in_reach": true, "observe": "GET /metrics serves Prometheus metrics", "recon": [["endpoint", "/metrics(\\?|$)"], ["lead", "prometheus|/metrics\\b"]]},
    "errorHandlingChallenge": {"in_reach": true, "observe": "GET of an unknown /rest or /api path returns a 500 page with a stack trace", "recon": [["lead", "stack.?trace|error page|unhandled|exception|debug"]]},
    "directoryListingChallenge": {"in_reach": true, "observe": "GET /ftp lists files (robots.txt disallows /ftp); acquisitions.md is readable", "recon": [["endpoint", "/ftp/?$|/ftp/acquisitions\\.md"], ["lead", "/ftp\\b.*(listing|index)|directory listing"]]},
    "redirectCryptoCurrencyChallenge": {"in_reach": true, "observe": "GET /redirect?to=<deprecated crypto address from main.js>", "recon": [["any", "redirect\\?to=https?(://|%3a%2f%2f)(blockchain\\.info|explorer\\.dash\\.org|etherscan\\.io)"]]},
    "adminSectionChallenge": {"in_reach": true, "observe": "hidden SPA route administration named in main.js", "recon": [["any", "[/#]administration\\b"]]},
