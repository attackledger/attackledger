  "surface": {
    "S01": {"title": "robots.txt names the /ftp directory", "in_reach": true, "recon": [["any", "robots\\.txt"]]},
    "S02": {"title": "Swagger UI for the B2B API at /api-docs", "in_reach": true, "recon": [["any", "/api-docs|swagger"]]},
    "S03": {"title": "/encryptionkeys lists the JWT public key and premium.key", "in_reach": true, "recon": [["any", "/encryptionkeys"]]},
    "S04": {"title": "/rest/admin/application-configuration returns the server configuration without authentication", "in_reach": true, "recon": [["any", "application-configuration"]]},
    "S05": {"title": "/rest/admin/application-version discloses the version without authentication", "in_reach": true, "recon": [["any", "application-version"]]},
    "S06": {"title": "CORS allows any origin (Access-Control-Allow-Origin: *)", "in_reach": true, "recon": [["lead", "\\bcors\\b|access-control-allow-origin"]]},
    "S07": {"title": "No Content-Security-Policy and no HSTS on the app", "in_reach": true, "recon": [["lead", "missing.{0,30}header|security.?headers|content-security-policy|strict-transport"]]},
    "S08": {"title": "Hard-coded test account credentials in main.js", "in_reach": true, "recon": [["lead", "IamUsedForTesting|testing@juice-sh\\.op|testingPassword"]]},
    "S09": {"title": "Product reviews API returns author email addresses without authentication", "in_reach": true, "recon": [["endpoint", "/rest/products/[^/]+/reviews"]]}
  }
