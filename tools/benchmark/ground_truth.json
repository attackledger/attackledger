    "misplacedIacFiles": {"in_reach": true, "observe": "GET /infrastructure/ lists Terraform and Docker files", "recon": [["any", "/infrastructure\\b"]]},
    "dbSchemaChallenge": {"in_reach": true, "observe": "GET /rest/products/search?q= is injectable (SQLite); a UNION SELECT on sqlite_master returns the schema", "recon": [["lead", "sqli-prone parameter: q\\b.*products/search|sql.?injection|sqli.*products/search"]]},
    "easterEggLevelOneChallenge": {"in_reach": true, "observe": "/ftp/eastere.gg through the poison null byte (%2500.md)", "recon": [["any", "eastere\\.gg"]]},
    "easterEggLevelTwoChallenge": {"in_reach": true, "observe": "decoding the eastere.gg content (base64, then ROT13) gives a GET path", "recon": [["any", "/the/devs/are/so/funny"]]},
    "nullByteChallenge": {"in_reach": true, "observe": "any /ftp file read through %2500.md", "recon": [["any", "%2500|%00|null.?byte"]]},
    "unionSqlInjectionChallenge": {"in_reach": true, "observe": "GET /rest/products/search?q= UNION SELECT on Users returns all emails and password hashes", "recon": [["lead", "sqli-prone parameter: q\\b.*products/search|sql.?injection|sqli.*products/search"]]},
    "accessLogDisclosureChallenge": {"in_reach": true, "observe": "GET /support/logs lists access logs", "recon": [["any", "/support/logs|access\\.log"]]},
    "misplacedSignatureFileChallenge": {"in_reach": true, "observe": "/ftp/suspicious_errors.yml through %2500.md", "recon": [["any", "suspicious_errors"]]},
    "forgottenDevBackupChallenge": {"in_reach": true, "observe": "/ftp/package.json.bak through %2500.md", "recon": [["any", "package\\.json\\.bak"]]},
    "forgottenBackupChallenge": {"in_reach": true, "observe": "/ftp/coupons_2013.md.bak through %2500.md", "recon": [["any", "coupons_2013"]]},
    "redirectChallenge": {"in_reach": true, "observe": "GET /redirect?to= accepts any URL that merely contains an allow-listed one", "recon": [["lead", "redirect-prone parameter: to\\b.*/redirect|open.?redirect"]]},
    "emailLeakChallenge": {"in_reach": true, "observe": "GET /rest/user/whoami?callback=x answers as JSONP", "recon": [["any", "whoami\\?[^ ]*callback|callback.*whoami|whoami.*callback"]]},
    "jwtUnsignedChallenge": {"in_reach": true, "observe": "a GET with an alg:none JWT for jwtn3d@juice-sh.op in the Authorization header is accepted", "recon": [["lead", "\\bjwt\\b|json web token|alg.?none"]]},

